{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Finans",
  "version": "1.24.0",
  "identifier": "com.ybrzcn.finans",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Finans",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src blob:; object-src 'self' blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https: http:",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Finance",
    "shortDescription": "Kişisel gelir, gider ve bütçe takibi",
    "longDescription": "Kişisel finans takibi: cihazda yerel ya da kendi sunucunuzda; hesaplar, kartlar, bütçe, ödeme takvimi ve borç planı.",
    "copyright": "© 2026 ybrzcn",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Turkish",
          "English"
        ]
      },
      "wix": {
        "language": [
          "tr-TR",
          "en-US"
        ]
      }
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDkxNTg0QkM4MjA5QTdEMzcKUldRM2Zab2d5RXRZa2RoTVRMKzNJLzJ4WW9lbEdIUjhmNE80Y1dNWlNvckUwN29MSEZ4NWpLNDEK",
      "endpoints": ["https://github.com/ybrzcn/Personal-Finance-Tracker/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
