# Kopyalayın: cp .env.example .env  — ve iki şifreyi değiştirin (yalnız harf ve rakam; ör. `openssl rand -hex 24`)
# Postgres yönetici şifresi (yalnız ilk kurulumda ve yönetim için)
POSTGRES_PASSWORD=degistirin-yonetici
# Uygulamanın Postgres kullanıcısı (finans) şifresi
FINANS_DB_PASSWORD=degistirin-uygulama
# İsteğe bağlı: TCMB EVDS API anahtarı (TÜFE; Kâr/Zarar sayfasında enflasyon karşılaştırması).
# evds3.tcmb.gov.tr → ücretsiz üye ol → Profil → API Anahtarı. Boşsa karşılaştırma kapalı.
FINANS_EVDS_KEY=
